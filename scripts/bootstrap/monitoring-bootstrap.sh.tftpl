#!/usr/bin/env bash
set -euo pipefail

grafana_password_b64="${grafana_password_b64}"
grafana_root_url="${grafana_root_url}"
repo_path="${nebula_repo_path}"

sudo systemctl enable --now docker >/dev/null 2>&1 || true
sudo systemctl is-active --quiet docker
sudo docker version >/dev/null

if ! sudo docker secret inspect grafana_admin_password >/dev/null 2>&1; then
  printf '%s' "$grafana_password_b64" | base64 -d | sudo docker secret create grafana_admin_password -
fi

tmp_stack="$(mktemp)"
cp "$repo_path/deploy/swarm/base/stack.monitoring.yml" "$tmp_stack"
sed -i "s|/home/etudiant/Nebula-infra-swarm|$repo_path|g" "$tmp_stack"
sed -i "s|^[[:space:]]*GF_SERVER_ROOT_URL:.*|      GF_SERVER_ROOT_URL: \"$grafana_root_url\"|" "$tmp_stack"

if sudo docker stack ls --format '{{.Name}}' | grep -qx monitoring; then
  sudo docker stack rm monitoring >/dev/null 2>&1 || true
  for _ in $(seq 1 30); do
    if ! sudo docker stack ls --format '{{.Name}}' | grep -qx monitoring; then
      break
    fi
    sleep 2
  done
fi

sudo docker stack deploy --detach=false -c "$tmp_stack" monitoring
sudo docker stack services monitoring
