#!/usr/bin/env bash
set -euo pipefail

repo_path="${repo_path}"
grafana_password_b64="${grafana_password_b64}"
grafana_root_url="${grafana_root_url}"

sudo systemctl enable --now docker >/dev/null 2>&1 || true
sudo systemctl is-active --quiet docker
sudo docker version >/dev/null

if ! sudo docker secret inspect grafana_admin_password >/dev/null 2>&1; then
  printf '%s' "$grafana_password_b64" | base64 -d | sudo docker secret create grafana_admin_password -
fi

cd "$repo_path"
sed -i "s|/home/etudiant/Nebula-infra-swarm|${repo_path}|g" deploy/swarm/base/stack.monitoring.yml
sed -i "s|GF_SERVER_ROOT_URL: .*|      GF_SERVER_ROOT_URL: \"${grafana_root_url}\"|" deploy/swarm/base/stack.monitoring.yml
bash scripts/deploy/deploy-monitoring.sh
sudo docker stack services monitoring
